# CasaMed App Admin — copy to .env.local for local dev; set the same keys in Vercel.
# Never commit real values.

# ── Firebase web SDK (public; used by the browser for Google sign-in) ─────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=casamed-6ec79.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=casamed-6ec79
NEXT_PUBLIC_FIREBASE_APP_ID=

# Domain whose Google accounts may sign in (client-side check + Google "hd" hint)
NEXT_PUBLIC_ADMIN_EMAIL_DOMAIN=casamed.in

# Demo mode: serve fixture data from lib/mocks.ts and skip sign-in. Keep false in real deploys.
NEXT_PUBLIC_USE_MOCKS=false

# ── Server only (BFF proxy + token verification) ─────────────────────────────
# Firebase project used to verify ID tokens (iss/aud). Falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=casamed-6ec79
# Only verified Google accounts on this domain pass the proxy.
ADMIN_EMAIL_DOMAIN=casamed.in

# Backend base URLs per environment (no trailing slash). Leave empty = "not deployed".
MONOLITH_URL_STAGING=
MONOLITH_URL_PRODUCTION=
POSTURE_URL_STAGING=
POSTURE_URL_PRODUCTION=
GAIT_URL_STAGING=
GAIT_URL_PRODUCTION=
DIET_URL_STAGING=
DIET_URL_PRODUCTION=
# Health-check only (System page)
ANALYTICS_URL_STAGING=
ANALYTICS_URL_PRODUCTION=
DMHTM_URL_STAGING=
DMHTM_URL_PRODUCTION=

# ── Mobile app config check (System page) ───────────────────────────────────
# Firebase web API key used by the mobile app; validated live, only last 4 shown.
APP_FIREBASE_WEB_API_KEY=
# Optional: mirror the app's EXPO_PUBLIC_* values as APP_<NAME> (e.g. APP_EXPO_PUBLIC_API_BASE_URL
# or APP_API_BASE_URL) so the System page can report which ones are provided. Values are never returned.
# APP_EXPO_PUBLIC_API_BASE_URL=
# APP_EXPO_PUBLIC_POSTURE_API_URL=
# APP_EXPO_PUBLIC_REHAB_API_URL=
# APP_EXPO_PUBLIC_NUTRITION_API_URL=
# APP_EXPO_PUBLIC_GAIT_API_URL=
# APP_EXPO_PUBLIC_DEV_BYPASS_OTP=
# APP_EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# APP_EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# APP_EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# APP_EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# APP_EXPO_PUBLIC_FIREBASE_APP_ID=
# APP_EXPO_PUBLIC_FORCE_REPORT_PAYWALL=
